<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CafeApp.WaiterWindows"
        x:DataType="vm:WaiterWindow"
        x:Class="CafeApp.WaiterWindows.WaiterWindow"
        Height="800" Width="1200"
        MinHeight="400" MinWidth="800"
        Title="Окно официанта">
    
        <TabControl>
                
                <TabItem Header="Заказы смены">
                        
                </TabItem>
                
                <TabItem Header="Отчеты">
                        
                </TabItem>
                
                <!-- Вкладка 3: Профиль -->
                <TabItem Header="Профиль">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Top"
                                    Margin="10"
                                    Spacing="10">
                                <TextBlock Text="Роль: Официант"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"/>
                                <Button Content="Выйти"
                                        Foreground="Red"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Name="LogOutBtn"
                                        Click="LogOutBtn_OnClick"/>
                        </StackPanel>
                </TabItem>
                
        </TabControl>
        
</Window>
