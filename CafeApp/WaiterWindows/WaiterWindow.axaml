<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CafeApp.WaiterWindows"
        x:DataType="vm:WaiterWindow"
        x:Class="CafeApp.WaiterWindows.WaiterWindow"
        Height="800" Width="1200"
        MinHeight="400" MinWidth="800"
        Title="Окно официанта">
    
        <TabControl>
                
                <!-- Вкладка 1: Заказы смены -->
                <TabItem Header="Заказы смены">
                        <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Spacing="10">
                                        <TextBlock Name="CurrentShiftTextBlock"
                                                   Text="{Binding CurrentShift.ShiftStarted, StringFormat=dd.MM.yyyy HH:mm}"
                                                   VerticalAlignment="Center"/>
                                        <Button Name="RefreshOrdersBtn"
                                                Content="Обновить"
                                                Click="RefreshOrdersBtn_OnClick"/>
                                        <Button Content="Удалить"
                                                Foreground="Red"
                                                Name="DeleteOrderBtn"
                                                IsEnabled="False"
                                                Click="DeleteOrderBtn_OnClick"/>
                                        <Button Content="Изменить"
                                                Name="EditOrderBtn"
                                                IsEnabled="False"
                                                Click="EditOrderBtn_OnClick"/>
                                        <Button Name="AddOrderBtn"
                                                Content="Создать заказ"
                                                Click="AddOrderBtn_OnClick"/>
                                </StackPanel>
                                <DataGrid Name="OrdersDataGrid"
                                          ItemsSource="{Binding Orders}"
                                          AutoGenerateColumns="False"
                                          CanUserReorderColumns="False"
                                          CanUserResizeColumns="True"
                                          ColumnWidth="auto"
                                          IsReadOnly="True"
                                          SelectionChanged="OrdersDataGrid_OnSelectionChanged">
                                        <DataGrid.Columns>
                                                <DataGridTextColumn Header="Столик" 
                                                                    Binding="{Binding Table.Number}"/>
                                                <DataGridTextColumn Header="Кол-во клиентов" 
                                                                    Binding="{Binding ClientsAmount}"/>
                                                <DataGridTextColumn Header="Статус" 
                                                                    Binding="{Binding Status}"/>
                                                <DataGridTextColumn Header="Сделан в" 
                                                                    Binding="{Binding CreatedAt, StringFormat=HH:mm}"/>
                                                <DataGridTextColumn Header="Выполнен в" 
                                                                    Binding="{Binding CompletedAt, StringFormat=HH:mm, TargetNullValue='Не выполнен'}"/>
                                                <DataGridTextColumn Header="Содержимое заказа" 
                                                                    Binding="{Binding Content}"/>
                                        </DataGrid.Columns>
                                </DataGrid>
                        </StackPanel>
                </TabItem>
                
                <!-- Вкладка 2: Отчеты -->
                <TabItem Header="Отчеты">
                        <Button Name="MakeReportBtn"
                                Content="Сформировать отчет за смену"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Click="MakeReportBtn_OnClick"/>
                </TabItem>
                
                <!-- Вкладка 3: Профиль -->
                <TabItem Header="Профиль">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Top"
                                    Margin="10"
                                    Spacing="10">
                                <TextBlock Text="Роль: Официант"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"/>
                                <Button Content="Выйти"
                                        Foreground="Red"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Name="LogOutBtn"
                                        Click="LogOutBtn_OnClick"/>
                        </StackPanel>
                </TabItem>
                
        </TabControl>
        
</Window>
