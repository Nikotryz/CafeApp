<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CafeApp.CookWindows"
        x:DataType="vm:CookWindow"
        x:Class="CafeApp.CookWindows.CookWindow"
        Height="800" Width="1200"
        MinHeight="400" MinWidth="800"
        Title="Окно повара">
    
    <TabControl>
        
        <!-- Вкладка 1: Заказы -->
        <TabItem Header="Принятые заказы">
            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Spacing="10">
                                        <TextBlock Name="CurrentShiftTextBlock"
                                                   Text="{Binding CurrentShift.ShiftStarted, StringFormat=dd.MM.yyyy HH:mm}"
                                                   VerticalAlignment="Center"/>
                                        <Button Name="RefreshOrdersBtn"
                                                Content="Обновить"
                                                Click="RefreshOrdersBtn_OnClick"/>
                                        <Button Content="Изменить"
                                                Name="EditOrderBtn"
                                                IsEnabled="False"
                                                Click="EditOrderBtn_OnClick"/>
                                </StackPanel>
                                <DataGrid Name="OrdersDataGrid"
                                          ItemsSource="{Binding Orders}"
                                          AutoGenerateColumns="False"
                                          CanUserReorderColumns="False"
                                          CanUserResizeColumns="True"
                                          ColumnWidth="auto"
                                          IsReadOnly="True"
                                          SelectionChanged="OrdersDataGrid_OnSelectionChanged">
                                        <DataGrid.Columns>
                                                <DataGridTextColumn Header="Столик" 
                                                                    Binding="{Binding Table.Number}"/>
                                                <DataGridTextColumn Header="Кол-во клиентов" 
                                                                    Binding="{Binding ClientsAmount}"/>
                                                <DataGridTextColumn Header="Статус" 
                                                                    Binding="{Binding Status}"/>
                                                <DataGridTextColumn Header="Сделан в" 
                                                                    Binding="{Binding CreatedAt, StringFormat=HH:mm}"/>
                                                <DataGridTextColumn Header="Выполнен в" 
                                                                    Binding="{Binding CompletedAt, StringFormat=HH:mm, TargetNullValue='Не выполнен'}"/>
                                                <DataGridTextColumn Header="Содержимое заказа" 
                                                                    Binding="{Binding Content}"/>
                                        </DataGrid.Columns>
                                </DataGrid>
                        </StackPanel>
        </TabItem>
        
        <!-- Вкладка 2: Профиль -->
        <TabItem Header="Профиль">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Margin="10"
                        Spacing="10">
                <TextBlock Text="Роль: Повар"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                <Button Content="Выйти"
                        Foreground="Red"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Name="LogOutBtn"
                        Click="LogOutBtn_OnClick"/>
            </StackPanel>
        </TabItem>
        
    </TabControl>
    
</Window>
