<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CafeApp"
        x:DataType="vm:UserEditWindow"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CafeApp.UserEditWindow"
        Title="UserEditWindow">
    
    <StackPanel Orientation="Vertical"
                Margin="25"
                VerticalAlignment="Center" >
        <TextBox Name="LoginTBox"
                 Watermark="Введите логин"
                 Margin="0 0 0 10"/>
        <TextBox Name="PasswordTBox"
                 Watermark="Введите пароль"
                 PasswordChar="*"
                 Margin="0 0 0 10"/>
        <ComboBox Name="RoleCBox"
                  ItemsSource="{Binding Roles}"
                  Margin="0 0 0 30"
                  Width="300">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
            
        <ListBox>
            <BehaviorCollectionTemplate>
                <BehaviorCollection>
                    <PanelDragBehavior></PanelDragBehavior>
                </BehaviorCollection>
            </BehaviorCollectionTemplate>
        </ListBox>
        
        <Button Content="Выбрать фото пользователя"
                HorizontalAlignment="Left"
                Margin="0 0 0 10"
                Name="UserPhotoBtn"
                Click="UserPhotoBtn_OnClick"/>
        
        <Button Content="Выбрать фото договора"
                HorizontalAlignment="Left"
                Margin="0 0 0 10"
                Name="ContractPhotoBtn"
                Click="ContractPhotoBtn_OnClick"/>
        
        <Button Content="Сохранить"
                HorizontalAlignment="Center"
                Margin="0 0 0 10"
                Name="SaveBtn"
                Click="SaveBtn_OnClick"/>
        <Button Content="Отмена"
                HorizontalAlignment="Center"
                Name="BackBtn"
                Click="BackBtn_OnClick"/>
    </StackPanel>
    
</Window>
