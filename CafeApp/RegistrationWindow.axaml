<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CafeApp"
        x:DataType="vm:RegistrationWindow"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CafeApp.RegistrationWindow"
        Title="Регистрация">
    
        <StackPanel Orientation="Vertical"
                    Margin="25"
                    VerticalAlignment="Center" >
                <TextBox Name="LoginTBox"
                         Watermark="Введите логин"
                         Margin="0 0 0 10"/>
                <TextBox Name="PasswordTBox"
                         Watermark="Введите пароль"
                         PasswordChar="*"
                         Margin="0 0 0 10"/>
                <Button Content="Зарегистрировать"
                        HorizontalAlignment="Center"
                        Margin="0 0 0 10"
                        Name="RegBtn"
                        Click="RegBtn_OnClick"/>
                <Button Content="Назад"
                        HorizontalAlignment="Center"
                        Name="BackBtn"
                        Click="BackBtn_OnClick"/>
        </StackPanel>
        
</Window>
