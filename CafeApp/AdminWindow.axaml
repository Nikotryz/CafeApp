<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CafeApp.AdminWindow"
        Title="AdminWindow">
    
        <TabControl>
                <TabItem Header="Сотрудники" >
                        <TextBlock Margin="5">Окно сотрудников</TextBlock>
                </TabItem>
                <TabItem Header="Заказы">
                        <TextBlock Margin="5">Окно заказов</TextBlock>
                </TabItem>
                <TabItem Header="Смены">
                        <TextBlock Margin="5">Окно смен</TextBlock>
                </TabItem>
                <TabItem Header="Отчеты">
                        <TextBlock Margin="5">Окно отчетов</TextBlock>
                </TabItem>
        </TabControl>
        
</Window>
