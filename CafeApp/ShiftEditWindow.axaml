<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CafeApp"
        Height="800" Width="1200"
        MinHeight="400" MinWidth="800"
        x:Class="CafeApp.ShiftEditWindow"
        x:DataType="vm:ShiftEditWindow"
        Title="Создание/редактирование смены">
    
        <StackPanel Orientation="Vertical"
                    Margin="25"
                    VerticalAlignment="Center" >
                <DatePicker Name="ShiftDPicker"
                            Margin="0 0 0 10"></DatePicker>
                <TimePicker Name="ShiftStartTPicker"
                            Margin="0 0 0 10"></TimePicker>
                <TimePicker Name="ShiftEndTPicker"
                            Margin="0 0 0 10"></TimePicker>
            
            <TextBlock Text="Сотрудники смены" Margin="0 10 0 10"/>
            <ListBox Name="SelectedUsersLBox"
                     ItemsSource="{Binding SelectedUsers}"
                     DisplayMemberBinding="{Binding Login}"
                     SelectionChanged="SelectedUsersLBox_OnSelectionChanged">
                <!--
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Blue" BorderThickness="1" 
                                CornerRadius="4" Padding="4">
                            <TextBlock Text="{Binding Login}"/>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                -->
            </ListBox>
            
            <TextBlock Text="Все сотрудники" Margin="0 10 0 10"/>
            <ListBox Name="UnselectedUsersLBox"
                     ItemsSource="{Binding UnselectedUsers}"
                     DisplayMemberBinding="{Binding Login}"
                     SelectionChanged="UnselectedUsersLBox_OnSelectionChanged"/>
            
            <Button Content="Сохранить"
                    Width="200"
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Margin="0 10 0 10"
                    Name="SaveBtn"
                    Click="SaveBtn_OnClick" />
            
            <Button Content="Отмена"
                    Width="200"
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Margin="0 10 0 10"
                    Name="CancelBtn"
                    Click="CancelBtn_OnClick" />
            
        </StackPanel>
        
</Window>
