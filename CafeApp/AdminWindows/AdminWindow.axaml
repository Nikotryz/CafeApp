<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CafeApp"
        x:DataType="vm:AdminWindow"
        Height="800" Width="1200"
        MinHeight="400" MinWidth="800"
        x:Class="CafeApp.AdminWindow"
        Title="Окно администратора">
    
        <TabControl>
                
                <!-- Вкладка 1: Сотрудники -->
                <TabItem Header="Сотрудники">
                        <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Spacing="10">
                                        <Button Name="RefreshUsersBtn"
                                                Content="Обновить"
                                                Click="RefreshUsersBtn_OnClick"/>
                                        <Button Content="Удалить"
                                                Foreground="Red"
                                                Name="UserDeleteBtn"
                                                IsEnabled="False"
                                                Click="UserDeleteBtn_OnClick"/>
                                        <Button Content="Изменить"
                                                Name="UserEditBtn"
                                                IsEnabled="False"
                                                Click="UserEditBtn_OnClick"/>
                                        <Button Name="AddUserBtn"
                                                Content="Добавить пользователя"
                                                Click="AddUserBtn_OnClick"/>
                                </StackPanel>
                                <DataGrid Name="UsersDGrid"
                                          ItemsSource="{Binding UsersList}"
                                          AutoGenerateColumns="False"
                                          CanUserReorderColumns="False"
                                          CanUserResizeColumns="True"
                                          ColumnWidth="*"
                                          SelectionChanged="UsersDataGrid_OnSelectionChanged">
                                        <DataGrid.Columns>
                                                <DataGridTextColumn Header="Логин" 
                                                                    Binding="{Binding Login}"
                                                                    Width="auto"/>
                                                <DataGridTextColumn Header="Пароль" 
                                                                    Binding="{Binding Password}"
                                                                    Width="auto"/>
                                                <DataGridTextColumn Header="Роль" 
                                                                    Binding="{Binding Role.Name}"
                                                                    Width="auto"/>
                                                <DataGridTextColumn Header="Статус" 
                                                                    Binding="{Binding Status}"
                                                                    Width="auto"/>
                                        </DataGrid.Columns>
                                </DataGrid>
                        </StackPanel>
                </TabItem>
                
                <!-- Вкладка 2: Смены -->
                <TabItem Header="Смены">
                        <StackPanel Orientation="Vertical"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Spacing="10">
                                        <Button Name="RefreshShiftsBtn"
                                                Content="Обновить"
                                                Click="RefreshShiftsBtn_OnClick"/>
                                        <Button Content="Удалить"
                                                Foreground="Red"
                                                Name="ShiftDeleteBtn"
                                                IsEnabled="False"
                                                HorizontalAlignment="Right"
                                                Click="ShiftDeleteBtn_OnClick"/>
                                        <Button Content="Изменить"
                                                Name="ShiftEditBtn"
                                                IsEnabled="False"
                                                HorizontalAlignment="Right"
                                                Click="ShiftEditBtn_OnClick"/>
                                        <Button Name="AddShiftBtn"
                                                Content="Добавить смену"
                                                HorizontalAlignment="Right"
                                                Click="AddShiftBtn_OnClick"/>
                                </StackPanel>
                                <DataGrid Name="ShiftsDGrid"
                                          ItemsSource="{Binding ShiftsList}"
                                          AutoGenerateColumns="False"
                                          CanUserReorderColumns="False"
                                          CanUserResizeColumns="True"
                                          ColumnWidth="*"
                                          SelectionChanged="ShiftsDataGrid_OnSelectionChanged">
                                        <DataGrid.Columns>
                                                <DataGridTextColumn Header="Дата" 
                                                                    Binding="{Binding ShiftStarted.Date, StringFormat=dd.MM.yyyy}"
                                                                    Width="auto"/>
                                                <DataGridTextColumn Header="Начало" 
                                                                    Binding="{Binding ShiftStarted, StringFormat=HH:mm}"
                                                                    Width="auto"/>
                                                <DataGridTextColumn Header="Конец" 
                                                                    Binding="{Binding ShiftEnds, StringFormat=HH:mm}"
                                                                    Width="auto"/>
                                                <DataGridTextColumn Header="Сотрудники"
                                                                    Binding="{Binding Users.Count}"
                                                                    Width="auto"/>
                                        </DataGrid.Columns>
                                </DataGrid>
                        </StackPanel>
                </TabItem>
                
                <!-- Вкладка 3: Столики -->
                <TabItem Header="Столики">
                         <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Spacing="10">
                                        <Button Name="RefreshTablesBtn"
                                                Content="Обновить"
                                                Click="RefreshTablesBtn_OnClick"/>
                                        <Button Content="Удалить"
                                                Foreground="Red"
                                                Name="DeleteTableBtn"
                                                IsEnabled="False"
                                                Click="DeleteTableBtn_OnClick"/>
                                        <Button Name="AddTableBtn"
                                                Content="Добавить столик"
                                                Click="AddTableBtn_OnClick"/>
                                </StackPanel>
                                <DataGrid Name="TablesDGrid"
                                          ItemsSource="{Binding TablesList}"
                                          AutoGenerateColumns="False"
                                          CanUserReorderColumns="False"
                                          CanUserResizeColumns="True"
                                          ColumnWidth="auto"
                                          SelectionChanged="TablesDataGrid_OnSelectionChanged">
                                        <DataGrid.Columns>
                                                <DataGridTextColumn Header="ID" 
                                                                    Binding="{Binding Id}"/>
                                                <DataGridTextColumn Header="Номер столика" 
                                                                    Binding="{Binding Number}"/>
                                        </DataGrid.Columns>
                                </DataGrid>
                        </StackPanel>
                </TabItem>
                
                <!-- Вкладка 4: Заказы -->
                <TabItem Header="Заказы">
                        <TextBlock Margin="5">Окно смен</TextBlock>
                </TabItem>
                
                <!-- Вкладка 5: Отчеты -->
                <TabItem Header="Отчеты">
                        <TextBlock Margin="5">Окно отчетов</TextBlock>
                </TabItem>
                
                <!-- Вкладка 6: Профиль -->
                <TabItem Header="Профиль">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Top"
                                    Margin="10"
                                    Spacing="10">
                                <TextBlock Text="Роль: Администратор"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"/>
                                <Button Content="Выйти"
                                        Foreground="Red"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Name="LogOutBtn"
                                        Click="LogOutBtn_OnClick"/>
                        </StackPanel>
                </TabItem>
                
        </TabControl>
        
</Window>
